        },
        "transcript_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Transcript Sha256",
          "type": "string"
        },
        "intended_flaw": {
          "enum": [
            "pacing",
            "pause_behavior",
            "energy_variation",
            "pitch_dynamics",
            "acceptable",
            "recording_quality",
            "alignment_uncertainty"
          ],
          "title": "Intended Flaw",
          "type": "string"
        },
        "intended_severity": {
          "enum": [
            0,
            1,
            2,
            3
          ],
          "title": "Intended Severity",
          "type": "integer"
        },
        "reviewed_severity": {
          "anyOf": [
            {
              "enum": [
                0,
                1,
                2,
                3
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed Severity"
        },
        "identity_status": {
          "enum": [
            "needs_review",
            "verified",
            "derived"
          ],
          "title": "Identity Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "reference_id",
        "participant_id",
        "transcript_sha256",
        "intended_flaw",
        "intended_severity",
        "identity_status"
      ],
      "title": "Pair",
      "type": "object"
    },
    "Processing": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "mono-polyphase-v1",
          "default": "mono-polyphase-v1",
          "title": "Algorithm",
          "type": "string"
        },
        "sample_rate_hz": {
          "const": 16000,
          "default": 16000,
          "title": "Sample Rate Hz",
          "type": "integer"
        },
        "subtype": {
          "const": "FLOAT",
          "default": "FLOAT",
          "title": "Subtype",
          "type": "string"
        },
        "channel": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Channel"
        },
        "versions": {
          "additionalProperties": {
            "maxLength": 100000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Versions",
          "type": "object"
        }
      },
      "required": [
        "channel",
        "versions"
      ],
      "title": "Processing",
      "type": "object"
    },
