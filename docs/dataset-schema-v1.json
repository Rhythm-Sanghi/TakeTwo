{
  "$defs": {
    "Annotation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "pair_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Pair Id",
          "type": "string"
        },
        "recording_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Recording Id",
          "type": "string"
        },
        "transcript_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Transcript Sha256",
          "type": "string"
        },
        "category": {
          "enum": [
            "pacing",
            "pause_behavior",
            "energy_variation",
            "pitch_dynamics",
            "acceptable",
            "recording_quality",
            "alignment_uncertainty"
          ],
          "title": "Category",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "severity": {
          "enum": [
            0,
            1,
            2,
            3
          ],
          "title": "Severity",
          "type": "integer"
        },
        "source": {
          "enum": [
            "human",
            "synthetic_recipe"
          ],
          "title": "Source",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "reviewed",
            "adjudicated"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "reviewer_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reviewer Id"
        },
        "rationale": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "uncertainty_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uncertainty S"
        },
        "token_span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Token Span"
        },
        "transformation_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Transformation Sha256"
        },
        "supersedes": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        }
      },
      "required": [
        "id",
        "pair_id",
        "recording_id",
        "transcript_sha256",
        "category",
        "start_s",
        "end_s",
        "severity",
        "source",
        "review_status",
        "reviewer_id",
        "rationale",
        "uncertainty_s",
        "token_span",
        "transformation_sha256"
      ],
      "title": "Annotation",
      "type": "object"
    },
    "AudioInfo": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "WAV",
            "FLAC"
          ],
          "title": "Format",
          "type": "string"
        },
        "subtype": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Subtype",
          "type": "string"
        },
        "sample_rate_hz": {
          "maximum": 96000,
          "minimum": 8000,
          "title": "Sample Rate Hz",
          "type": "integer"
        },
        "channels": {
          "enum": [
            1,
            2
          ],
          "title": "Channels",
          "type": "integer"
        },
        "frames": {
          "exclusiveMinimum": 0,
          "title": "Frames",
          "type": "integer"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Duration S",
          "type": "number"
        },
        "rms_dbfs": {
          "title": "Rms Dbfs",
          "type": "number"
        },
        "peak": {
          "minimum": 0,
          "title": "Peak",
          "type": "number"
        },
        "clipping_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Clipping Fraction",
          "type": "number"
        }
      },
      "required": [
        "format",
        "subtype",
        "sample_rate_hz",
        "channels",
        "frames",
        "duration_s",
        "rms_dbfs",
        "peak",
        "clipping_fraction"
      ],
      "title": "AudioInfo",
      "type": "object"
    },
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "insert_pause",
            "shorten_pause",
            "tempo",
            "gain",
            "pitch_shift"
          ],
          "title": "Kind",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "severity": {
          "enum": [
            1,
            2,
            3
          ],
          "title": "Severity",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start_s",
        "end_s",
        "value",
        "severity"
      ],
      "title": "Operation",
      "type": "object"
    },
    "Pair": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
